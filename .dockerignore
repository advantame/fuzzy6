# Only inputs used by Vite and the production server enter the build context.
**
!package.json
!package-lock.json
!.nvmrc
!vite.config.js
!index.html
!src/
!src/**
!decks/
!decks/**
!public/
!public/**
!server/
!server/**
# Also exclude synthesis originals in a working-tree build. The standing figures stay in: git
# ignores them, and ship-app.sh adds them to the context from .shipinclude.
decks/*/voice/**/*.wav
**/node_modules/
**/.*/
**/.*
!.nvmrc
